# Template GoodVibe © 2026 Jean-Noël Lefebvre (Le Cinquième Jour) — PolyForm Noncommercial 1.0.0, voir LICENSE.md
# Clé API Google Gemini (à créer sur https://aistudio.google.com/apikey, facturation activée sur son projet : fiche 1)
GEMINI_API_KEY=

# Modèles Gemini : aucun n'est imposé. L'agent recommande le modèle texte au PLAN
# de la fiche 1 et le modèle image au PLAN de la fiche 10.
MODELE_TEXTE=
MODELE_IMAGE=

# Accès à la page web GoodVibe (Gradio), obligatoires.
# Choisissez un mot de passe long, jamais celui d'un autre compte.
WEB_USER=
WEB_PASSWORD=

# Ports de cet agent IA sur le serveur : les mêmes que dans deploy/site.caddy.
# Premier agent IA : 7860 et 8000 ; deuxième : 7861 et 8001 ; et ainsi de suite.
PORT_GRADIO=7860
PORT_WEBHOOK=8000

# Serveur MCP fetch (horoscope). En local, "uvx" suffit.
# Sur le serveur, ni le service ni le cron ne connaissent le dossier de uvx :
# on donne son chemin complet (deploy/deployer.sh l'inscrit s'il manque).
# MCP_FETCH_COMMAND=/home/{{NOM_AGENT}}/.local/bin/uvx
