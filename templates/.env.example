# Clé API Google Gemini (à créer sur https://aistudio.google.com/apikey, facturation activée sur son projet : fiche 1)
GEMINI_API_KEY=

# Modèles Gemini : aucun n'est imposé. L'agent recommande le modèle texte au PLAN
# de la fiche 1 et le modèle image au PLAN de la fiche 10, et les inscrit ici,
# jamais dans config.py. Même valeur sur l'ordinateur du pilote et sur le serveur.
MODELE_TEXTE=
MODELE_IMAGE=

# Accès à la page web GoodVibe (Gradio), obligatoires.
# Choisissez un mot de passe long, jamais celui d'un autre compte.
WEB_USER=
WEB_PASSWORD=

# Ports de cet agent IA sur le serveur : les mêmes que dans deploy/site.caddy.
# Premier agent IA : 7860 et 8000 ; deuxième : 7861 et 8001 ; et ainsi de suite.
PORT_GRADIO=7860
PORT_WEBHOOK=8000

# Serveur MCP fetch (horoscope). En local, "uvx" suffit.
# Sur le serveur, ni le service ni le cron ne connaissent le dossier de uvx :
# on donne son chemin complet (deploy/deployer.sh l'inscrit s'il manque).
# MCP_FETCH_COMMAND=/home/{{NOM_AGENT}}/.local/bin/uvx

# Pense-bête du serveur, sur l'ordinateur du pilote seulement (fiche 12).
# Le programme ne lit pas ces lignes : elles disent où est la page en ligne et
# comment y entrer. Mêmes noms que les secrets GitHub de la fiche 13.
# L'agent les ajoute par une commande, sauf VPS_WEB_PASSWORD, que le pilote écrit.
# VPS_URL=https://{{NOM_AGENT}}.1-2-3-4.sslip.io
# VPS_HOST=1.2.3.4
# VPS_USER={{NOM_AGENT}}
# VPS_SSH_KEY_PATH=C:\Users\moi\.ssh\id_ed25519
# VPS_WEB_USER=
# VPS_WEB_PASSWORD=
